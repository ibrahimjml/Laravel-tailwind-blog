APP_NAME=Myblog4u
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_ROOT_PASSWORD=root
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel-blog
DB_USERNAME=laravel
DB_PASSWORD=secret

BROADCAST_ENABLED=false
BROADCAST_DRIVER=reverb
CACHE_ENABLED=true
CACHE_DRIVER=redis
FILESYSTEM_DISK=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2 

# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=#
# MAIL_PASSWORD=#
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SCOUT_DRIVER=tntsearch
SCOUT_QUEUE=true

TNTSEARCH_FUZZINESS=true
TNTSEARCH_AS_YOU_TYPE=true
TNTSEARCH_BOOLEAN=false
TNTSEARCH_MAX_DOCS=500
### Admin
ADMIN_USERNAME="admin123"
ADMIN_EMAIL="admin@mail.ru"
ADMIN_PASS="adminadmin123"
USER_USERNAME="demo22"
USER_PASS="demo1234567"
### google recaptcha v3
GOOGLE_SITEKEY=
GOOGLE_SECRETKEY=
IS_DEMO=false

## google analytics
ANALYTICS_CREDENTIALS_JSON=app/private/analytics/analytics-credentials.json

## reverb server 
REVERB_APP_ID=local_id
REVERB_APP_KEY=local_key
REVERB_APP_SECRET=local_secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

## Public connection with SSL
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}" 
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"